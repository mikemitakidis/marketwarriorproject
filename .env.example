# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# App URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration (use test keys for testing!)
# Test keys start with sk_test_ and pk_test_
# Live keys start with sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_PRICE_ID=price_your_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin Configuration
ADMIN_EMAIL_ALLOWLIST=your-email@example.com,another-admin@example.com
ADMIN_PASSWORD_HASH=your-bcrypt-hash

# Cron Job Secret (for keep-alive endpoint)
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# Development Bypass (REMOVED - no longer supported)
# Use only NODE_ENV=development for testing
